# ================================
# 🏠 My Homelab Environment Variables
# ================================
# Copy this file to .env and update the values

# ================================
# Global
# ================================
TZ=Asia/Jakarta

# Network Binding Configuration
# Set to 127.0.0.1 for local access only (more secure)
# Set to 0.0.0.0 for public access (accessible from LAN/WAN)
BIND_IP=0.0.0.0

# ================================
# Actual Budget
# ================================
ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20
ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SYNC_SIZE_LIMIT_MB=50
ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20
ACTUAL_BUDGET_CPU_LIMIT=0.5
ACTUAL_BUDGET_MEMORY_LIMIT=256M

# ================================
# AdGuard Home
# ================================
ADGUARD_HOME_SETUP_PORT=3095
ADGUARD_HOME_CPU_LIMIT=0.5
ADGUARD_HOME_MEMORY_LIMIT=256M

# ================================
# Beszel
# ================================
BESZEL_CPU_LIMIT=0.5
BESZEL_MEMORY_LIMIT=256M
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=
BESZEL_AGENT_CPU_LIMIT=0.5
BESZEL_AGENT_MEMORY_LIMIT=256M

# ================================
# Bento PDF
# ================================
BENTO_PDF_CPU_LIMIT=0.5
BENTO_PDF_MEMORY_LIMIT=256M

# ================================
# Blesta
# ================================
BLESTA_ADDRESS=127.0.0.1
BLESTA_HOST=blesta.yourdomain.com
BLESTA_CPU_LIMIT=1
BLESTA_MEMORY_LIMIT=1G

# ================================
# Bugsink
# ================================
BUGSINK_SECRET_KEY=your_secret
BUGSINK_CREATE_SUPERUSER=admin:your_secure_password
BUGSINK_DATABASE_URL=postgresql://bugsinkuser:your_super_secret_password@db:5432/bugsink
BUGSINK_BEHIND_HTTPS_PROXY=true
BUGSINK_BASE_URL=https://bugsink.yourdomain.com
BUGSINK_CPU_LIMIT=0.5
BUGSINK_MEMORY_LIMIT=256M

# ================================
# ChangeDetection
# ================================
CHANGEDETECTION_PLAYWRIGHT_URL=ws://browser-sockpuppet-chrome:3000
CHANGEDETECTION_BASE_URL=https://changedetection.yourdomain.com
CHANGEDETECTION_FETCH_WORKERS=10
CHANGEDETECTION_CPU_LIMIT=0.5
CHANGEDETECTION_MEMORY_LIMIT=512M
# Sockpuppet Browser
SOCKPUPPET_SCREEN_WIDTH=1920
SOCKPUPPET_SCREEN_HEIGHT=1024
SOCKPUPPET_SCREEN_DEPTH=16
SOCKPUPPET_MAX_CONCURRENT_CHROME_PROCESSES=10
SOCKPUPPETBROWSER_CPU_LIMIT=1
SOCKPUPPETBROWSER_MEMORY_LIMIT=1G

# ================================
# ERPNext
# ================================
ERPNEXT_SITE_NAME=frontend
ERPNEXT_ADMIN_PASSWORD=your_secure_password
ERPNEXT_DB_HOST=mariadb
ERPNEXT_DB_NAME=erpnext
ERPNEXT_DB_USER=erpnext
ERPNEXT_DB_PASSWORD=your_db_password
ERPNEXT_REDIS_HOST=redis
ERPNEXT_REDIS_CACHE=:your_secure_password@redis:6379/0
ERPNEXT_REDIS_QUEUE=:your_secure_password@redis:6379/1
ERPNEXT_SOCKETIO_PORT=9000
ERPNEXT_PROXY_READ_TIMEOUT=120
ERPNEXT_CLIENT_MAX_BODY_SIZE=50m
ERPNEXT_CPU_LIMIT=1
ERPNEXT_MEMORY_LIMIT=2G
ERPNEXT_WORKER_CPU_LIMIT=1
ERPNEXT_WORKER_MEMORY_LIMIT=1G

# ================================
# Excalidraw
# ================================
EXCALIDRAW_CPU_LIMIT=0.5
EXCALIDRAW_MEMORY_LIMIT=512M

# ================================
# FlareSolverr
# ================================
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_LOG_FILE=none
FLARESOLVERR_LOG_HTML=false
FLARESOLVERR_CAPTCHA_SOLVER=none
FLARESOLVERR_CPU_LIMIT=1
FLARESOLVERR_MEMORY_LIMIT=1G

# ================================
# Grafana
# ================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
GRAFANA_CPU_LIMIT=1
GRAFANA_MEMORY_LIMIT=512M

# ================================
# Homepage
# ================================
HOMEPAGE_ALLOWED_HOSTS=home.yourdomain.com,home.local
HOMEPAGE_SERVICE_DOMAIN=local
HOMEPAGE_PUID=1000
HOMEPAGE_PGID=1000
HOMEPAGE_VAR_LOGO_ICON=https://upload.wikimedia.org/wikipedia/commons/thumb/d/d5/I_Love_New_York.svg/1101px-I_Love_New_York.svg.png
HOMEPAGE_VAR_BACKGROUND_IMAGE=https://images.unsplash.com/photo-1502790671504-542ad42d5189?auto=format&fit=crop&w=2560&q=80
HOMEPAGE_CPU_LIMIT=0.5
HOMEPAGE_MEMORY_LIMIT=256M

# ================================
# InfluxDB
# ================================
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=password
INFLUXDB_ORG=homelab
INFLUXDB_BUCKET=bucket
INFLUXDB_ADMIN_TOKEN=token
INFLUXDB_CPU_LIMIT=1
INFLUXDB_MEMORY_LIMIT=1G

# ================================
# IT Tools
# ================================
IT_TOOLS_CPU_LIMIT=0.5
IT_TOOLS_MEMORY_LIMIT=256M

# ================================
# Listmonk
# ================================
LISTMONK_DB_USER=root
LISTMONK_DB_PASSWORD=your_secure_password
LISTMONK_DB_NAME=listmonk
LISTMONK_DB_HOST=postgres
LISTMONK_DB_PORT=5432
LISTMONK_DB_SSL_MODE=disable
LISTMONK_DB_MAX_OPEN=25
LISTMONK_DB_MAX_IDLE=25
LISTMONK_DB_MAX_LIFETIME=300s
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=your_secure_password
LISTMONK_CPU_LIMIT=1
LISTMONK_MEMORY_LIMIT=1G

# ================================
# MariaDB
# ================================
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=your_secure_password
MARIADB_USER=root
MARIADB_PASSWORD=your_secure_password
MARIADB_CPU_LIMIT=1
MARIADB_MEMORY_LIMIT=1G

# ================================
# MongoDB
# ================================
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=your_secure_password
MONGODB_CPU_LIMIT=1
MONGODB_MEMORY_LIMIT=1G

# ================================
# N8N
# ================================
N8N_DB_NAME=n8n
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_USER=root
N8N_DB_PASSWORD=your_secure_password
N8N_CPU_LIMIT=1
N8N_MEMORY_LIMIT=1G

# ================================
# Netdata
# ================================
NETDATA_HOSTNAME=my-homelab
NETDATA_CLAIM_TOKEN=your_netdata_claim_token_here
NETDATA_CLAIM_ROOMS=your_netdata_room_id_here
NETDATA_CLAIM_URL=https://app.netdata.cloud
NETDATA_CPU_LIMIT=1
NETDATA_MEMORY_LIMIT=512M

# ================================
# Nextcloud
# ================================
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=root
NEXTCLOUD_DB_HOST=mariadb
NEXTCLOUD_CPU_LIMIT=1
NEXTCLOUD_MEMORY_LIMIT=1G

# ================================
# Ollama
# ================================
OLLAMA_HSA_OVERRIDE_GFX_VERSION=10.3.0
OLLAMA_CPU_LIMIT=4
OLLAMA_MEMORY_LIMIT=8G

# ================================
# OnlyOffice
# ================================
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=your_secure_jwt_secret
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_CPU_LIMIT=1
ONLYOFFICE_MEMORY_LIMIT=2G

# ================================
# Open WebUI
# ================================
OPEN_WEBUI_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_SECRET_KEY=your_secure_secret_key
OPEN_WEBUI_CPU_LIMIT=1
OPEN_WEBUI_MEMORY_LIMIT=2G

# ================================
# OpenSpeedTest
# ================================
OPENSPEEDTEST_CPU_LIMIT=0.5
OPENSPEEDTEST_MEMORY_LIMIT=256M

# ================================
# Portainer
# ================================
PORTAINER_CPU_LIMIT=0.5
PORTAINER_MEMORY_LIMIT=256M

# ================================
# PostgreSQL
# ================================
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=your_secure_password
POSTGRES_CPU_LIMIT=1
POSTGRES_MEMORY_LIMIT=1G

# ================================
# Redis
# ================================
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M

# ================================
# Ryot
# ================================
RYOT_FRONTEND_URL=https://ryot.yourdomain.com
RYOT_DATABASE_URL=postgres://root:your_secure_password@postgres:5432/ryot
RYOT_SERVER_ADMIN_ACCESS_TOKEN=your_secure_admin_token
RYOT_SERVER_IMPORTER_TRAKT_CLIENT_ID=your_trakt_client_id
RYOT_MOVIES_AND_SHOWS_TMDB_ACCESS_TOKEN=your_tmdb_access_token
RYOT_ANIME_AND_MANGA_MAL_CLIENT_ID=your_mal_client_id
RYOT_CPU_LIMIT=0.5
RYOT_MEMORY_LIMIT=512M

# ================================
# SerpBear
# ================================
SERPBEAR_USER=admin
SERPBEAR_PASSWORD=your_secure_password
SERPBEAR_SECRET=your_secure_secret
SERPBEAR_APIKEY=your_api_key
NEXT_PUBLIC_APP_URL=https://serpbear.yourdomain.com
SERPBEAR_CPU_LIMIT=0.5
SERPBEAR_MEMORY_LIMIT=512M

# ================================
# SmokePing
# ================================
SMOKEPING_PUID=1000
SMOKEPING_PGID=1000
SMOKEPING_MASTER_URL=
SMOKEPING_CPU_LIMIT=0.5
SMOKEPING_MEMORY_LIMIT=256M

# ================================
# Socks5
# ================================
SOCKS5_PORT=1080
SOCKS5_USER=your_username
SOCKS5_PASSWORD=your_password
SOCKS5_CPU_LIMIT=0.5
SOCKS5_MEMORY_LIMIT=512M

# ================================
# Stirling PDF
# ================================
STIRLING_PDF_SECURITY_ENABLELOGIN=true
STIRLING_PDF_LANGS=en_US
STIRLING_PDF_CPU_LIMIT=1
STIRLING_PDF_MEMORY_LIMIT=2G

# ================================
# Traefik
# ================================
TRAEFIK_DOMAIN=yourdomain.com
LOCAL_DOMAIN=local
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$yourhashhere
TRAEFIK_CPU_LIMIT=0.5
TRAEFIK_MEMORY_LIMIT=256M

# ================================
# Uptime Kuma
# ================================
UPTIME_KUMA_CPU_LIMIT=0.5
UPTIME_KUMA_MEMORY_LIMIT=256M

# ================================
# Wallos
# ================================
WALLOS_CPU_LIMIT=0.5
WALLOS_MEMORY_LIMIT=256M

# ================================
# Wealthfolio
# ================================
WEALTHFOLIO_SECRET_KEY=your_secret
WEALTHFOLIO_CORS_ALLOW_ORIGINS=https://wealthfolio.yourdomain.com
WEALTHFOLIO_REQUEST_TIMEOUT_MS=30000
WEALTHFOLIO_STATIC_DIR=dist
WEALTHFOLIO_AUTH_PASSWORD_HASH=your_secret
WEALTHFOLIO_AUTH_TOKEN_TTL_MINUTES=60
WEALTHFOLIO_AUTH_REQUIRED=false
WEALTHFOLIO_CPU_LIMIT=0.5
WEALTHFOLIO_MEMORY_LIMIT=512M

# ================================
# WordPress
# ================================
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_USER=root
WORDPRESS_DB_PASSWORD=your_secure_password
WORDPRESS_DB_NAME=wordpress
WORDPRESS_CPU_LIMIT=1
WORDPRESS_MEMORY_LIMIT=1G